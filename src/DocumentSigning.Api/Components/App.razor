<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document Signing Portal</title>
    <base href="/" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <!-- Static loading overlay shown before Blazor SignalR circuit connects -->
    <div id="blazor-preload" style="position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#f8fafc,#eff6ff);z-index:9999">
        <div style="text-align:center;font-family:system-ui,sans-serif">
            <div style="width:3rem;height:3rem;border:4px solid #bfdbfe;border-top-color:#2563eb;border-radius:50%;animation:sp2-spin .8s linear infinite;margin:0 auto 1rem"></div>
            <p style="color:#64748b;font-weight:500;margin:0">Loading document portal&hellip;</p>
        </div>
        <style>@@keyframes sp2-spin{to{transform:rotate(360deg)}}</style>
    </div>
    <!-- blazor.server.js must load first (autostart=false), then we start manually -->
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script src="js/signaturePad.js"></script>
    <script>
        Blazor.start().then(function () {
            var el = document.getElementById('blazor-preload');
            if (el) el.remove();
        });
    </script>
</body>
</html>
