@page "/reset-password/{Token}"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false))
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav

<PageTitle>Reset Password – Document Signing</PageTitle>

<style>
    .rp-overlay {
        min-height: 100vh;
        background: linear-gradient(135deg,#f0f4ff 0%,#e8f5e9 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Inter',system-ui,sans-serif;
        padding: 1.5rem;
    }
    .rp-card {
        background: #fff;
        border-radius: 1.25rem;
        box-shadow: 0 8px 32px rgba(30,64,175,.10);
        width: 100%;
        max-width: 440px;
        padding: 2.5rem 2rem;
    }
    .rp-logo {
        display: flex;
        align-items: center;
        gap: .6rem;
        margin-bottom: 1.5rem;
    }
    .rp-logo svg { width: 2rem; height: 2rem; color: #3b82f6; }
    .rp-logo-text { font-size: 1.1rem; font-weight: 700; color: #1e293b; }
    .rp-title { font-size: 1.35rem; font-weight: 700; color: #1e293b; margin-bottom: .35rem; }
    .rp-sub { font-size: .875rem; color: #64748b; margin-bottom: 1.75rem; }
    .rp-label { display: block; font-size: .8rem; font-weight: 600; color: #374151; margin-bottom: .35rem; margin-top: 1rem; }
    .rp-input {
        width: 100%; box-sizing: border-box;
        padding: .65rem .9rem;
        border: 1.5px solid #e2e8f0;
        border-radius: .6rem;
        font-size: .95rem;
        outline: none;
        transition: border-color .15s;
    }
    .rp-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,.12); }
    .rp-rules { font-size: .75rem; color: #94a3b8; margin-top: .4rem; }
    .rp-btn {
        margin-top: 1.5rem;
        width: 100%;
        padding: .75rem;
        background: #3b82f6;
        color: #fff;
        border: none;
        border-radius: .6rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s, opacity .15s;
    }
    .rp-btn:hover:not(:disabled) { background: #2563eb; }
    .rp-btn:disabled { opacity: .6; cursor: not-allowed; }
    .rp-alert {
        margin-top: 1rem;
        padding: .75rem 1rem;
        border-radius: .6rem;
        font-size: .875rem;
        font-weight: 500;
    }
    .rp-alert-err  { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .rp-alert-ok   { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
    .rp-back { margin-top: 1.25rem; text-align: center; font-size: .85rem; color: #64748b; }
    .rp-back a { color: #3b82f6; text-decoration: none; font-weight: 500; }
    .rp-back a:hover { text-decoration: underline; }
    .rp-spinner {
        display: inline-block;
        width: 1rem; height: 1rem;
        border: 2px solid rgba(255,255,255,.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: rp-spin .6s linear infinite;
        vertical-align: middle;
        margin-right: .4rem;
    }
    @@keyframes rp-spin { to { transform: rotate(360deg); } }
</style>

<div class="rp-overlay">
    <div class="rp-card">

        <div class="rp-logo">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span class="rp-logo-text">Document Signing</span>
        </div>

        @if (_success)
        {
            <div class="rp-title">Password updated!</div>
            <div class="rp-sub">Your password has been changed successfully. You can now log in.</div>
            <div class="rp-alert rp-alert-ok">Password reset successful.</div>
        }
        else
        {
            <div class="rp-title">Set a new password</div>
            <div class="rp-sub">Enter and confirm your new password below.</div>

            <label class="rp-label" for="rp-pw">New Password</label>
            <input id="rp-pw"
                   type="password"
                   class="rp-input"
                   placeholder="Min 8 chars, upper + lower + digit"
                   @bind="_newPassword"
                   @bind:event="oninput"
                   disabled="@_busy" />

            <label class="rp-label" for="rp-pw2">Confirm Password</label>
            <input id="rp-pw2"
                   type="password"
                   class="rp-input"
                   placeholder="Repeat new password"
                   @bind="_confirmPassword"
                   @bind:event="oninput"
                   disabled="@_busy" />

            <div class="rp-rules">Must be at least 8 characters and contain uppercase, lowercase, and a digit.</div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="rp-alert rp-alert-err">@_errorMessage</div>
            }

            <button class="rp-btn" @onclick="Submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_newPassword) || string.IsNullOrWhiteSpace(_confirmPassword))">
                @if (_busy)
                {
                    <span class="rp-spinner"></span>
                }
                Reset Password
            </button>
        }

        <div class="rp-back">
            <a href="javascript:void(0)" @onclick='() => Nav.NavigateTo("/")'>&#8592; Back to home</a>
        </div>

    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private string _newPassword     = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _errorMessage    = string.Empty;
    private bool   _busy            = false;
    private bool   _success         = false;

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "Passwords do not match.";
            return;
        }

        if (_newPassword.Length < 8 ||
            !_newPassword.Any(char.IsUpper) ||
            !_newPassword.Any(char.IsLower) ||
            !_newPassword.Any(char.IsDigit))
        {
            _errorMessage = "Password must be at least 8 characters and contain uppercase, lowercase, and a digit.";
            return;
        }

        _busy = true;
        try
        {
            var http = HttpFactory.CreateClient("api");
            var response = await http.PostAsJsonAsync("/api/auth/reset-password", new
            {
                token       = Token,
                newPassword = _newPassword
            });

            if (response.IsSuccessStatusCode)
            {
                _success = true;
            }
            else
            {
                var body = await response.Content.ReadFromJsonAsync<ErrorBody>();
                _errorMessage = body?.Message ?? "Reset failed. The link may have expired. Please request a new one.";
            }
        }
        catch
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private record ErrorBody(string? Message);
}
